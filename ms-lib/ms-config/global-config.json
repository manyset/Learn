{
  "_comment": "CHANGE ONLY VALUES. NOT THE TAG NAMES.  - Help: https://www.manyset.com/Docs/GlobalConfig/",
  "AutoConfig": "true",
  "Debug": "true",

  "ErrorSettings": {
    "ErrorPopup": true,
    "ErrorWarning": "System error occured. Re try.",
    "ErrorDetail": true,
    "ErrorConsole": true,
    "ErrorServerURL": null,
    "ErrorCustomPopupURL": "./HTML/CustomErr.html"
  },
  "DatabaseAccess": {
    "DbReadComponents": [
      "./Sales/InvoComp1",
      "./Reports/",
      "XXlogin",
      "https://abc.com/abc/"
    ],
    "DbWriteComponents": [
      "./Sales/InvoComp1",
      "./Reports/",
      "XXlogin",
      "https://abc.com/abc/"
    ]
  },
  "HttpSettings": {
    "Defaults": {
      "Timeout": 30000,
      "Credentials": "same-origin",
      "Headers": {
        "Accept": "application/json"
      },
      "AllowedOrigins": [
        "self"
      ],
      "Logging": false
    },
    "ComponentServices": {
      "./App/Shell/login": "Auth",
      "./Sales/": "Sales",
      "./Inventory/": "Inventory",
      "./ServerTest1": "Inventory",
      "./ServerGridData": "Inventory"
    },
    "Services": {
      "Auth": {
        "BaseURL": "/api/auth",
        "Credentials": "include",
        "Authentication": {
          "Type": "Cookie"
        },
        "AllowedComponents": [
          "./App/Shell/login"
        ]
      },
      "Sales": {
        "BaseURL": "/api/sales",
        "Authentication": {
          "Type": "Bearer",
          "TokenStoreKey": "auth.accessToken"
        },
        "AllowedComponents": [
          "./Sales/"
        ]
      },
      "Inventory": {
        "BaseURL": "http://localhost:5000/api/inventory",
        "AllowedOrigins": [
          "http://localhost:5000"
        ],
        "AllowedComponents": [
          "./Inventory/",
          "./Sales/",
          "./ServerTest1",
          "./ServerGridData",
          "./grid"
        ]
      }
    }
  },
  "LoadingAnimation": {
    "Enabled": true,
    "FullScreen": false,
    "Type_can_be:": "skeleton, skeleton-spinner, spinner, wave, image",
    "Type": "image",
    "AnimatedImage": "./IMAGES/AnimatedGif.gif",
    "ImageSize": "80,80",
    "BackgroundOpacity": 0.01,
    "ContentOpacity": 0.65,
    "FadeDuration": 0,
    "Delay": 0,
    "LockUI": false,
    "Blur": false,
    "SpinnerSize": 40,
    "CSS": "./CSS/DefaultLoadingBackground.css"
  },
  "CommonCSS": [
    "./Sales/OurSys1.css",
    "./CommonReports.css",
    "https://www.Hicharts.com/repo/HiCharts.css"
  ],
  "default-css": {
    "button": "./CSS/ButtonDefault.css",
    "input": "./CSS/InputDefault.css",
    "select": "./CSS/SelectDefault.css",
    "label": "./CSS/LabelDefault.css",
    "check": "./CSS/CheckDefault.css",
    "radio": "./CSS/RadioDefault.css",
    "div": "./CSS/DIvDefault.css",
    "ms-com": "./CSS/MsComDefault.css",
    "img": "./CSS/ImageDefault.css",
    "image": "./CSS/ImageDefault.css",
    "section": "./CSS/SectionDefault.css",
    "layout": "./CSS/LayoutDefault.css",
    "dialog": "./CSS/DialogDefault.css",
    "popup": "./CSS/PopupDefault.css",
    "combo": "./CSS/ComboDefault.css",
    "grid": "./CSS/GridDefault.css"
  },
  "GlobalDOMEvents": [],
  "EventBus": {
    "EventEmitComponents": [
      "Sales/",
      "Inventory/"
    ],
    "EventListenComponents": [
      "*"
    ]
  }
}
