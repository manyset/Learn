<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>

        <!-- CRITICAL: Headers for OPFS -->
        <httpProtocol>
            <customHeaders>
                <add name="Cross-Origin-Opener-Policy" value="same-origin" />
                <add name="Cross-Origin-Embedder-Policy" value="require-corp" />
            </customHeaders>
        </httpProtocol>

        <!-- CRITICAL: MIME types for SQLite files -->
        <staticContent>
            <remove fileExtension=".wasm" />
            <remove fileExtension=".mjs" />
            <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
            <mimeMap fileExtension=".mjs" mimeType="application/javascript" />

            <!-- Let browsers keep static files for a week -->
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
        </staticContent>

        <!-- Caching rules: html always fresh, everything else cached 7 days -->
        <caching>
            <profiles>
                <add extension=".html" policy="DisableCache" />
                <add extension=".js" policy="CacheForTimePeriod" duration="7.00:00:00" location="Any" />
                <add extension=".mjs" policy="CacheForTimePeriod" duration="7.00:00:00" location="Any" />
                <add extension=".wasm" policy="CacheForTimePeriod" duration="7.00:00:00" location="Any" />
            </profiles>
        </caching>
        <defaultDocument>
            <files>
                <clear />
                <add value="index.html" />
                <add value="Default.htm" />
                <add value="Default.asp" />
                <add value="index.htm" />
                <add value="iisstart.htm" />
            </files>
        </defaultDocument>
    </system.webServer>
</configuration>