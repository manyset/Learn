{
  "Debug": "false",
  "AutoConfig": "true",
  "CommonCSS": [
    "./Sales/OurSys1.css",
    "./CommonReports.css",
    "https://www.Hicharts.com/repo/HiCharts.css"
  ],
  "CommonJS": [
    "./Sales/OurSys1.mjs",
    "./CommonReports.js",
    "./helper.js",
    "./IdConflictTest/IdConflictTest.js",
    "https://www.Hicharts.com/repo/HiCharts.js"
  ],
  "DatabaseAccess": {
    "DbReadComponents": [
      "./Sales/InvoComp1",
      "./Reports/",
      "XXlogin",
      "https://abc.com/abc/"
    ],
    "DbWriteComponents": [
      "./Sales/InvoComp1",
      "./Reports/",
      "XXlogin",
      "https://abc.com/abc/"
    ]
  },
  "ErrorSettings": {
    "ErrorConsole": true,
    "ErrorCustomPopupURL": "./msHTML/CustomErr.html",
    "ErrorDetail": true,
    "ErrorPopup": true,
    "ErrorServerURL": null,
    "ErrorWarning": "System error occured. Re try."
  },
  "EventBus": {
    "EventEmitComponents": [
      "Sales/",
      "Inventory/"
    ],
    "EventListenComponents": [
      "*"
    ]
  },
  "GlobalDOMEvents": [],
  "HttpSettings": {
    "ComponentServices": {
      "./App/Shell/login": "Auth",
      "./Inventory/": "Inventory",
      "./Sales/": "Sales",
      "./ServerGridData": "Inventory",
      "./ServerTest1": "Inventory"
    },
    "Defaults": {
      "AllowedOrigins": [
        "self"
      ],
      "Credentials": "same-origin",
      "Headers": {
        "Accept": "application/json"
      },
      "Logging": false,
      "Timeout": 30000
    },
    "Services": {
      "Auth": {
        "AllowedComponents": [
          "./App/Shell/login"
        ],
        "Authentication": {
          "Type": "Cookie"
        },
        "BaseURL": "/api/auth",
        "Credentials": "include"
      },
      "Inventory": {
        "AllowedComponents": [
          "./Inventory/",
          "./Sales/",
          "./ServerTest1",
          "./ServerGridData",
          "./grid"
        ],
        "AllowedOrigins": [
          "http://localhost:5000"
        ],
        "BaseURL": "http://localhost:5000/api/inventory"
      },
      "Sales": {
        "AllowedComponents": [
          "./Sales/"
        ],
        "Authentication": {
          "TokenStoreKey": "auth.accessToken",
          "Type": "Bearer"
        },
        "BaseURL": "/api/sales"
      }
    }
  },
  "LoadingAnimation": {
    "AnimatedImage": "./msConfig/IMAGES/AnimatedGif.gif",
    "BackgroundOpacity": 0.01,
    "Blur": false,
    "CSS": "./msConfig/CSS/DefaultLoadingBackground.css",
    "ContentOpacity": 0.65,
    "Delay": 0,
    "Enabled": true,
    "FadeDuration": 0,
    "FullScreen": false,
    "ImageSize": "80,80",
    "LockUI": false,
    "SpinnerSize": 40,
    "Type": "image",
    "Type_can_be:": "skeleton, skeleton-spinner, spinner, wave, image"
  },
  "_comment": "Do not change Tags. Change values only. Help: https://www.manySet.com/Docs/GlobalConfig/",
  "default-css": {
    "button": "./msConfig/CSS/ButtonDefault.css",
    "check": "./msConfig/CSS/CheckDefault.css",
    "combo": "./msConfig/CSS/ComboDefault.css",
    "dialog": "./msConfig/CSS/DialogDefault.css",
    "div": "./msConfig/CSS/DIvDefault.css",
    "grid": "./msConfig/CSS/GridDefault.css",
    "image": "./msConfig/CSS/ImageDefault.css",
    "img": "./msConfig/CSS/ImageDefault.css",
    "input": "./msConfig/CSS/InputDefault.css",
    "label": "./msConfig/CSS/LabelDefault.css",
    "layout": "./msConfig/CSS/LayoutDefault.css",
    "ms-com": "./msConfig/CSS/MsComDefault.css",
    "popup": "./msConfig/CSS/PopupDefault.css",
    "radio": "./msConfig/CSS/RadioDefault.css",
    "section": "./msConfig/CSS/SectionDefault.css",
    "select": "./msConfig/CSS/SelectDefault.css"
  }
}